{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://gd-skill-codex.local/schemas/test-plan.schema.json",
    "title":  "GD Skill Codex TestPlan",
    "type":  "object",
    "required":  [
                     "tests"
                 ],
    "properties":  {
                       "version":  {
                                       "type":  "string",
                                       "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
                                   },
                       "tests":  {
                                     "type":  "array"
                                 },
                       "coverage":  {
                                        "type":  "array"
                                    }
                   },
    "additionalProperties":  true
}
