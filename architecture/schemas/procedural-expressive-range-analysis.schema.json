{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-skill-codex.local/schemas/procedural-expressive-range-analysis.schema.json",
  "title": "GD Skill Codex procedural expressive range analysis",
  "type": "object",
  "required": ["version", "solvability_status", "bc_dimensions", "generated_samples"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "solvability_status": { "type": "string", "minLength": 1 },
    "bc_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "bins"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "bins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "min", "max"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "min": { "type": "number" },
                "max": { "type": "number" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "generated_samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "values"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "values": { "type": "object" },
          "valid": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
