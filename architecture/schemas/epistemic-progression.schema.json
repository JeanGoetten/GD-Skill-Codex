{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-skill-codex.local/schemas/epistemic-progression.schema.json",
  "title": "GD Skill Codex epistemic progression model",
  "type": "object",
  "required": ["holons", "clues"],
  "properties": {
    "holons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "root": { "type": "boolean" },
          "terminal": { "type": "boolean" },
          "physically_accessible_at_start": { "type": "boolean" },
          "access_requires_inventory": { "type": "boolean" },
          "optional": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "equivalence_group": { "type": "string" },
          "required_for_terminal": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "known_holons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
