{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://gd-skill-codex.local/schemas/assumption.schema.json",
    "title":  "GD Skill Codex Assumption",
    "type":  "object",
    "required":  [
                     "statement"
                 ],
    "properties":  {
                       "statement":  {
                                         "minLength":  1,
                                         "type":  "string"
                                     },
                       "id":  {
                                  "type":  "string",
                                  "pattern":  "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                              },
                       "confidence":  {
                                          "enum":  [
                                                       "low",
                                                       "medium",
                                                       "high"
                                                   ]
                                      },
                       "impact":  {
                                      "type":  "string"
                                  },
                       "validation":  {
                                          "type":  "string"
                                      }
                   },
    "additionalProperties":  true
}
