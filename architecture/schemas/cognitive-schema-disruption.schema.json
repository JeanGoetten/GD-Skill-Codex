{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-skill-codex.local/schemas/cognitive-schema-disruption.schema.json",
  "title": "GD Skill Codex cognitive schema disruption model",
  "type": "object",
  "required": ["conventions", "disruptions"],
  "properties": {
    "default_repetitions": { "type": "integer", "minimum": 0 },
    "conventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "repetitions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repetitions": { "type": "integer", "minimum": 0 },
          "salience": { "type": "number", "minimum": 0, "maximum": 1 },
          "consistent_feedback": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "disruptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "convention_id", "magnitude", "threshold", "hidden_coherence", "agency_preserved"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "convention_id": { "type": "string", "minLength": 1 },
          "magnitude": { "type": "number", "minimum": 0 },
          "threshold": { "type": "number", "minimum": 0 },
          "hidden_coherence": { "type": "boolean" },
          "agency_preserved": { "type": "boolean" },
          "strategic_variable_changed": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
