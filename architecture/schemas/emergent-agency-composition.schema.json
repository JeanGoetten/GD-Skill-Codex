{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-skill-codex.local/schemas/emergent-agency-composition.schema.json",
  "title": "GD Skill Codex emergent agency composition model",
  "type": "object",
  "required": ["atomic_verbs", "properties_matrix", "compositions"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "max_chain_depth": { "type": "integer", "minimum": 1 },
    "energy_drain_per_trigger": { "type": "number", "minimum": 0 },
    "atomic_verbs": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "preconditions", "effects"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "effects": { "type": "array", "items": { "type": "string" } },
          "cost": { "type": "number", "minimum": 0 },
          "challenge_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "target_property": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "properties_matrix": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity_id", "properties", "susceptibilities"],
        "properties": {
          "entity_id": { "type": "string", "minLength": 1 },
          "properties": { "type": "object" },
          "susceptibilities": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "compositions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "first_verb", "second_verb", "connection_preconditions", "result", "synergy_factor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "first_verb": { "type": "string", "minLength": 1 },
          "second_verb": { "type": "string", "minLength": 1 },
          "connection_preconditions": { "type": "array", "items": { "type": "string" } },
          "result": { "type": "string", "minLength": 1 },
          "synergy_factor": { "type": "number", "minimum": 0 },
          "effect_radius": { "type": "number", "minimum": 0 },
          "reverse_result": { "type": "string" },
          "destructive_collateral": { "type": "boolean" },
          "novel_affordance": { "type": "boolean" },
          "reward": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
