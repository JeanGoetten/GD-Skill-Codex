{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-skill-codex.local/schemas/risk-reward-action.schema.json",
  "title": "GD Skill Codex committed risk-reward action model",
  "type": "object",
  "required": ["action_contracts"],
  "properties": {
    "reaction_min_frames": { "type": "integer", "minimum": 0 },
    "action_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stamina_cost", "recovery", "damage"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stamina_cost": { "type": "number", "minimum": 0 },
          "max_stamina": { "type": "number", "exclusiveMinimum": 0 },
          "dodge_cost": { "type": "number", "minimum": 0 },
          "recovery": { "type": "integer", "minimum": 0 },
          "damage": { "type": "number", "minimum": 0 },
          "average_damage": { "type": "number", "exclusiveMinimum": 0 },
          "punishment_multiplier": { "type": "number", "minimum": 1 },
          "hitbox_area": { "type": "number", "minimum": 0 },
          "hurtbox_area": { "type": "number", "minimum": 0 },
          "escape_window_frames": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
