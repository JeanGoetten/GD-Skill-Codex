{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://gd-skill-codex.local/schemas/skill-output.schema.json",
    "title":  "GD Skill Codex SkillOutput",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "skill_id",
                     "status",
                     "claims",
                     "metrics",
                     "anomalies",
                     "assumptions",
                     "evidence",
                     "limitations",
                     "handoffs"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "type":  "string",
                                              "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
                                          },
                       "skill_id":  {
                                        "$ref":  "https://gd-skill-codex.local/schemas/ids.schema.json#/$defs/skillId"
                                    },
                       "status":  {
                                      "enum":  [
                                                   "success",
                                                   "partial",
                                                   "blocked",
                                                   "failed"
                                               ]
                                  },
                       "world_model":  {
                                           "type":  "object"
                                       },
                       "results":  {
                                       "type":  "object"
                                   },
                       "metrics":  {
                                       "type":  "array"
                                   },
                       "evidence":  {
                                        "type":  "array"
                                    },
                       "handoffs":  {
                                        "type":  "array"
                                    },
                       "errors":  {
                                      "items":  { "type": "string" },
                                      "type":  "array"
                                  },
                       "claims": { "type": "array" },
                       "anomalies": { "type": "array" },
                       "assumptions": { "type": "array" },
                       "limitations": { "type": "array" },
                       "conflicts": { "type": "array" },
                       "input_context": { "type": ["object", "null"] }
                   },
    "additionalProperties": false
}
