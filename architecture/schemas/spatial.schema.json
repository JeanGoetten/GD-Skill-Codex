{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://gd-skill-codex.local/schemas/spatial.schema.json",
    "title":  "GD Skill Codex spatial model",
    "type":  "object",
    "properties":  {
                       "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
                       "world_model_version": { "type": "string", "minLength": 1 },
                       "analysis_version": { "type": "string", "minLength": 1 },
                       "skill_version": { "type": "string", "minLength": 1 },
                       "nodes":  {
                                     "type":  "array",
                                     "items": {
                                         "type": "object",
                                         "required": ["id"],
                                         "properties": {
                                             "id": { "type": "string", "minLength": 1 },
                                             "position": { "type": "array" },
                                             "tags": { "type": "array" },
                                             "epistemological_status": { "enum": ["unknown", "assumed", "observed", "derived", "validated"] },
                                             "metadata": { "type": "object" }
                                         },
                                         "additionalProperties": true
                                     }
                                 },
                       "edges":  {
                                     "type":  "array",
                                     "items": {
                                         "type": "object",
                                         "required": ["from", "to"],
                                         "properties": {
                                             "from": { "type": "string", "minLength": 1 },
                                             "to": { "type": "string", "minLength": 1 },
                                             "requires": { "type": "array" },
                                             "epistemological_status": { "enum": ["unknown", "assumed", "observed", "derived", "validated"] }
                                         },
                                         "additionalProperties": true
                                     }
                                 },
                       "graph":  {
                                     "type":  "object"
                                 }
                   },
    "additionalProperties":  true
}
