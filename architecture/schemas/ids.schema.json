{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://gd-skill-codex.local/schemas/ids.schema.json",
    "title":  "GD Skill Codex identifiers",
    "$defs":  {
                  "id":  {
                             "type":  "string",
                             "pattern":  "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                         },
                  "version":  {
                                  "type":  "string",
                                  "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
                              },
                  "skillId":  {
                                  "type":  "string",
                                  "pattern":  "^[a-z0-9][a-z0-9-]{1,127}$"
                              }
              },
    "type":  "object",
    "properties":  {
                       "id":  {
                                  "type":  "string",
                                  "pattern":  "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                              },
                       "version":  {
                                       "type":  "string",
                                       "pattern":  "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
                                   }
                   },
    "additionalProperties":  true
}
