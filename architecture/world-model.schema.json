{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-skill-codex.local/world-model.schema.json",
  "title": "GD Skill Codex shared world state",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    }
  },
  "type": "object",
  "required": [
    "entities",
    "resources",
    "spatial",
    "temporal",
    "rules",
    "knowledge",
    "progression",
    "economy",
    "actors",
    "actions",
    "goals",
    "hidden_state"
  ],
  "properties": {
    "version": { "$ref": "#/$defs/version" },
    "entities": { "$ref": "https://gd-skill-codex.local/schemas/entities.schema.json" },
    "resources": { "$ref": "https://gd-skill-codex.local/schemas/resources.schema.json" },
    "spatial": { "$ref": "https://gd-skill-codex.local/schemas/spatial.schema.json" },
    "temporal": { "$ref": "https://gd-skill-codex.local/schemas/temporal.schema.json" },
    "rules": { "$ref": "https://gd-skill-codex.local/schemas/rules.schema.json" },
    "knowledge": { "$ref": "https://gd-skill-codex.local/schemas/knowledge.schema.json" },
    "progression": { "$ref": "https://gd-skill-codex.local/schemas/progression.schema.json" },
    "economy": { "$ref": "https://gd-skill-codex.local/schemas/economy.schema.json" },
    "actors": { "$ref": "https://gd-skill-codex.local/schemas/actors.schema.json" },
    "actions": { "$ref": "https://gd-skill-codex.local/schemas/actions.schema.json" },
    "goals": { "$ref": "https://gd-skill-codex.local/schemas/goals.schema.json" },
    "hidden_state": { "$ref": "https://gd-skill-codex.local/schemas/hidden-state.schema.json" },
    "ontology": {
      "type": "object",
      "description": "Núcleo ontológico comum; projections especializadas podem reutilizar os mesmos identificadores.",
      "properties": {
        "entities": { "type": "array" },
        "properties": { "type": "array" },
        "relations": { "type": "array" },
        "actions": { "type": "array" },
        "events": { "type": "array" },
        "states": { "type": "array" },
        "rules": { "type": "array" },
        "goals": { "type": "array" },
        "observations": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
