{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-skill-codex.local/evidence.schema.json",
  "title": "GD Skill Codex evidence record",
  "type": "object",
  "required": ["claim", "status", "assumptions", "evidence", "confidence", "limitations"],
  "properties": {
    "claim": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["formal", "derived", "heuristic", "empirical", "observed", "assumed", "unknown", "contradicted", "validated", "INSUFFICIENT_EVIDENCE"]
    },
    "model": { "type": "string", "minLength": 1 },
    "skill_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "calculation": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "enum": ["input", "observation", "simulation", "playtest", "calculation", "reference"] },
          "id": { "type": "string", "minLength": 1 },
          "uri": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "validation": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "input_hash": { "type": "string" },
    "world_model_version": { "type": "string" },
    "skill_version": { "type": "string" },
    "seed": { "type": ["integer", "string"] },
    "created_at": { "type": "string", "format": "date-time" }
    ,"provenance": {
      "type": "object",
      "required": ["input_hash", "world_model_version", "skill_version", "source_kind"],
      "properties": {
        "input_hash": { "type": "string", "minLength": 1 },
        "world_model_version": { "type": "string", "minLength": 1 },
        "skill_version": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
