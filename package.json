{
  "name": "gd-skill-codex",
  "version": "1.1.0",
  "description": "Typed, evidence-aware framework of game-system analysis skills for AI agents and designers.",
  "directories": {
    "doc": "docs"
  },
  "bin": {
    "gd-codex": "bin/gd-codex.js"
  },
  "scripts": {
    "test": "node architecture/validate_json_schema.js",
    "test:unit": "node --test architecture/tests/executor_fixes.test.js",
    "test:regression": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./architecture/regression_tests.ps1",
    "test:all": "node architecture/run_all.js",
    "sync:skills": "node architecture/sync_skill_runtime.js",
    "mcp": "node mcp/server.js",
    "validate:skills": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./validate_skills.ps1",
    "validate:schema": "node architecture/validate_json_schema.js",
    "serve": "node web/server.js"
  },
  "keywords": ["game-design", "systems-design", "ai-agents", "formal-methods", "simulation", "mcp"],
  "author": "Jean Goetten",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
